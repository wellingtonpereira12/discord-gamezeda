{
  "name": "fakedc",
  "version": "1.4.0",
  "description": "FakeDC - Discord Clone com Chat em Tempo Real, Compartilhamento de Tela WebRTC e Cliente Desktop Electron",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "electron": "electron electron/main.cjs",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "play-dl": "^1.9.7",
    "socket.io": "^4.7.5",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "com.fakedc.desktop",
    "productName": "FakeDC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "FakeDC",
      "uninstallDisplayName": "FakeDC",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "FakeDC-Setup.${ext}"
    }
  }
}
